# Copy this file to .env and fill in what you need.
# Every value is optional; the defaults shown here are used when a line is missing.

# --- Benzinga news (catalyst briefings) ---
# Get a key from https://www.benzinga.com/apis/ . Without it the scanner falls back
# to Yahoo Finance headlines for the catalyst column.
BENZINGA_API_KEY=

# --- Scan criteria ---
MIN_GAP_PCT=5            # gap up vs previous close, in percent
MIN_PRICE=3              # minimum share price in USD
MIN_PREMARKET_VOLUME=50000

# --- Universe (which tickers get checked) ---
# yahoo = pull every US stock matching UNIVERSE_* filters from the Yahoo Finance screener
# file  = only the tickers listed in WATCHLIST_FILE (one per line)
UNIVERSE_SOURCE=yahoo
UNIVERSE_MIN_AVG_VOLUME=50000   # 3-month average daily volume filter for the Yahoo universe
MAX_UNIVERSE=8000               # safety cap on the number of tickers scanned
WATCHLIST_FILE=watchlist.txt

# --- Schedule (US Eastern time, weekdays only) ---
SCAN_TIME_ET=08:30           # first pre-market scan (Scanner A)
SCAN_END_ET=14:00            # last pre-market scan
SCAN_INTERVAL_MIN=30         # minutes between pre-market scans
STRATEGY_OFFSET_MIN=5        # Scanner B runs this many minutes after each Scanner A run
STRATEGY_END_ET=15:00        # last Scanner B run

# --- Telegram delivery (both scanners' results after every run) ---
# 1) In Telegram talk to @BotFather, send /newbot, copy the token here.
# 2) Open a chat with your bot and press Start.
# 3) Run: python telegram_setup.py --save   (verifies the token, fills TELEGRAM_CHAT_ID, sends a test)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Extra groups/channels (comma-separated ids) that also get the reports and signals. System
# messages such as the webhook URL stay in TELEGRAM_CHAT_ID only. Fill with: telegram_setup.py --add-chat
TELEGRAM_EXTRA_CHAT_IDS=
# th = plain Thai for readers without a trading background (default), en = compact English
REPORT_LANGUAGE=th
# Show the news headline under each ticker in sections A/B (false = signals only, shorter message)
REPORT_NEWS=false
# Which sections the report carries: A = pre-market gappers, B = Trend-join hits, C = special watchlist signals
REPORT_SECTIONS=A,B,C          # owner chat (TELEGRAM_CHAT_ID)
GROUP_REPORT_SECTIONS=         # groups/channels in TELEGRAM_EXTRA_CHAT_IDS: empty = no report, alerts only
# Alerts the groups get (owner gets all): new = entry signals, exit = T/P/stop/expiry,
# trail = stop moved, weakened, held
GROUP_ALERTS=new
# Translate English news headlines to Thai when shown (free public service; keeps English if it fails)
TRANSLATE_NEWS=true

# --- Scanner C: currency pairs, gold, bitcoin ---
# tradingview (default): real-time quotes, symbols like OANDA:XAUUSD (spot gold), FX:EURUSD, BITSTAMP:BTCUSD
# mt5: your broker's prices through the MetaTrader 5 terminal on this PC, symbols like XAUUSD, EURUSD, BTCUSD
# yahoo: symbols like EURUSD=X, GC=F (no spot gold on Yahoo), BTC-USD
SPECIAL_ENABLED=true
SPECIAL_DATA_SOURCE=tradingview
SPECIAL_WATCHLIST=FX:EURUSD,FX:GBPUSD,FX:USDJPY,FX_IDC:USDTHB,OANDA:XAUUSD,BITSTAMP:BTCUSD

# --- MetaTrader 5 (only with SPECIAL_DATA_SOURCE=mt5; empty = attach to the logged-in terminal) ---
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Read-only account report (owner chat): balance/equity, open positions, closes
PORTFOLIO_ENABLED=true
PORTFOLIO_TO_GROUP=false
# Confirm-to-trade button -> order request file for the EA (mt5_ea/SignalBotBridge.mq5)
EA_BRIDGE_ENABLED=true
EA_FILES_DIR=                  # empty = <MT5 Common data>\Files\signalbot
EA_RISK_PCT=1.0                # % of balance risked to the stop (lot sizing)
EA_TP_R=1.0                    # take-profit in R written to the request (0 = none)
TELEGRAM_COMMANDS_ENABLED=true # buttons and /status /orders /test commands (owner only)

# --- TradingView webhook receiver: TradingView alert -> this bot -> Telegram ---
# Needs a paid TradingView plan (webhook alerts) and a tunnel (e.g. cloudflared) to expose the port.
# Webhook URL to paste in TradingView:  https://<tunnel-host>/tv?key=<TV_WEBHOOK_SECRET>
TV_WEBHOOK_ENABLED=true
TV_WEBHOOK_BIND=127.0.0.1
TV_WEBHOOK_PORT=8787
TV_WEBHOOK_SECRET=            # any long random string; telegram_setup-style generated value is fine
# Cloudflare quick tunnel (needs cloudflared.exe): the scheduler starts it and sends the public URL to Telegram
TUNNEL_ENABLED=true
CLOUDFLARED_PATH=             # empty = auto-detect (Program Files (x86)\cloudflared)
TUNNEL_NOTIFY=true

# --- Scanner C watch mode: alert the moment a new Trend-join Long entry appears ---
SPECIAL_WATCH_ENABLED=true
SPECIAL_WATCH_INTERVAL_MIN=5   # minutes between checks, all day, every day
ATR_PERIOD=14                  # days used for the average daily range (ATR)
STOP_ATR_MULT=1.0              # stop-loss = entry - this x ATR
TARGET_R_MULT=2.0              # target = entry + this x (entry - stop)
STALE_QUOTE_MIN=30             # skip a symbol whose quote is older than this (market closed)
# Live exit (v2-trail) and the gold-only time/news filter
PARTIAL_R=1.0                  # take half at this many R
TRAIL_ATR_MULT=3.0             # trailing stop distance in ATR below the highest price
MAX_HOLD_DAYS=10               # close the rest after this many trading days
TRAIL_NOTIFY_ATR=0.5           # alert when the trailing stop rises by this many ATR
TIME_FILTER_SYMBOLS=XAUUSD,GOLD,GC=F   # session/news filter applies to these (backtest: helps gold only)
SESSION_UTC_START=7            # London open
SESSION_UTC_END=20             # late New York
FRIDAY_CUTOFF_UTC=15           # no new filtered signals on Friday from this hour (UTC)
NEWS_BLACKOUT_MIN=30           # minutes around a high-impact US release
NEWS_CALENDAR_ENABLED=true     # ForexFactory weekly calendar (falls back to the payrolls/FOMC rule)

# --- Strategy scanner: Trend-join Long (runs after the open on the pre-market results) ---
# tradingview = yesterday's high/close, 200 SMA and pre-market high from TradingView's screener
#               (matches your TradingView charts); live price from Yahoo unless the cookie below
#               gives TradingView streaming data.
# yahoo       = everything from Yahoo Finance.
STRATEGY_DATA_SOURCE=tradingview
# Optional: TradingView "sessionid" cookie of a logged-in account with real-time US data.
# Without it TradingView prices are delayed 15 minutes, so the live price comes from Yahoo.
TRADINGVIEW_SESSIONID=
STRATEGY_START_ET=10:00      # earliest time a Trend-join Long signal counts as valid
HOD_TOLERANCE_PCT=0.25       # "at the high of day" = within this % of the day's high

# --- Output ---
OUTPUT_DIR=output
NEWS_LOOKBACK_HOURS=48
